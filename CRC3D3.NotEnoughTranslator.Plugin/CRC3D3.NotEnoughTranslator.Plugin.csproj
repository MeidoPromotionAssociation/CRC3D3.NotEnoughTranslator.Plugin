<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <Configurations>Debug;Release</Configurations>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>CRC3D3.NotEnoughTranslator.Plugin</RootNamespace>

    <!-- 版本号唯一来源是插件主类里的 PluginVersion 常量，csproj 和源码里都不再重复写。
         AssemblyVersion / FileVersion / MyPluginInfo.PLUGIN_VERSION 由 SDK 从下面的 <Version> 推导。
         The PluginVersion constant in the plugin class is the single source of the version;
         the SDK derives AssemblyVersion / FileVersion / MyPluginInfo.PLUGIN_VERSION from <Version>. -->
    <PluginVersionFromSource>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/CRC3D3.NotEnoughTranslator.Plugin.cs')), 'PluginVersion\s*=\s*&quot;([0-9][0-9.]*)&quot;').Groups[1].Value)</PluginVersionFromSource>
    <Version Condition="'$(PluginVersionFromSource)' != ''">$(PluginVersionFromSource)</Version>
  </PropertyGroup>

  <!-- net48 的引用程序集（CI 上没有装 .NET Framework，靠这个包补）
       Reference assemblies for the .NET Framework target, needed on Linux CI -->
  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" Version="1.0.3"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" PrivateAssets="all" Version="1.*"/>
    <PackageReference Include="BepInEx.Core" Version="5.*"/>
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*"/>
    <PackageReference Include="UnityEngine.Modules" IncludeAssets="compile" Version="2022.3.62"/>
    <PackageReference Include="Newtonsoft.Json" Version="13.*"/>
    <Reference Include="System.IO.Compression"/>
    <Reference Include="System.IO.Compression.FileSystem"/>
    
    <Reference Include="I2.Localization">
      <HintPath>../lib/I2.Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>../lib/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>../lib/Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
  </ItemGroup>
  
  <PropertyGroup>
    <Authors>MeidoPromotionAssociation</Authors>
    <Company>MeidoPromotionAssociation</Company>
    <Copyright>Bsd 3-Clause License</Copyright>
    <Description>https://github.com/MeidoPromotionAssociation/CRC3D3.NotEnoughTranslator.Plugin</Description> <!-- For BepInEx.ConfigurationManager -->
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
  </PropertyGroup>
  <!-- 常量读不出来时给出可读报错，而不是悄悄编出 1.0.0.0
       Fail loudly when the constant cannot be read instead of silently building 1.0.0.0 -->
  <Target Name="CheckPluginVersion" BeforeTargets="BeforeBuild"
          Condition="'$(PluginVersionFromSource)' == ''">
    <Error Text="无法从 CRC3D3.NotEnoughTranslator.Plugin.cs 的 PluginVersion 常量读取版本号，请检查它是否形如 public const string PluginVersion = &quot;0.0.1&quot;。" />
  </Target>

</Project>
